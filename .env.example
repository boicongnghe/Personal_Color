# ── Server (server/.env) ──────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/clarity
JWT_SECRET=replace-with-random-256bit-secret
PORT=3001
CLIENT_URL=http://localhost:5173

# ── AI Microservice ───────────────────────────────────────
AI_SERVICE_URL=http://localhost:5001

# ── Affiliate ─────────────────────────────────────────────
SHOPEE_AFF_ID=your-shopee-affiliate-id
TIKTOK_AFF_ID=your-tiktok-shop-affiliate-id

# ── VNPay (sandbox) ───────────────────────────────────────
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3001/api/subscription/callback

# ── Client (root .env or .env.local) ─────────────────────
VITE_API_URL=http://localhost:3001
